<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Сеть нужна только при промахе локального поиска: опрос сервера и Open Food
        Facts по штрих-коду плюс отправка заведённых вручную продуктов.
        Разрешение камеры объявляет :feature:scanner — там оно и живёт.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        WorkManager объявляет foreground-сервис «на всякий случай», а Google Play
        за каждое такое разрешение требует декларацию с видео. Отправка вкладов
        идёт обычной фоновой работой и в передний план не выходит никогда.
        Понадобится setForeground — убрать эти три строки и заполнить декларацию.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <application
        android:name=".KcalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KcalAI">

        <!--
            Экран — вертикальная лента с композером: альбомная раскладка
            ничего не добавляет, а поворот рвёт ввод и сканер.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KcalAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>

</manifest>
