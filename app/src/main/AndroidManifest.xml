<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Сеть нужна только при промахе локального поиска: опрос сервера и Open Food
        Facts по штрих-коду плюс отправка заведённых вручную продуктов.
        Разрешение камеры объявляет :feature:scanner — там оно и живёт.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Яйцо, Масло и Зёрнышко пишут первыми — только если человек сам разрешил
        в ленте («Пишите»), и только тогда спрашивается это разрешение.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        WorkManager и Play Asset Delivery объявляют foreground-сервисы «на всякий случай»,
        а Google Play за каждое такое разрешение требует декларацию с видео. Отправка вкладов
        и распаковка пака идут обычной фоновой работой и в передний план не выходят.
        Понадобится setForeground — вернуть разрешения и сервисы ниже, убрать правило
        keepRules/foreground.keep и заполнить декларацию.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <application
        android:name=".KcalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KcalAI">

        <!--
            Экран — вертикальная лента с композером: альбомная раскладка
            ничего не добавляет, а поворот рвёт ввод и сканер.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KcalAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!--
            Распаковка пака с моделью. Сам сервис убрать нельзя: библиотека включает его при
            старте и упала бы, не найдя. Остаётся обычным сервисом, без типа foreground, а
            вызов startForeground вырезает keepRules/foreground.keep.
        -->
        <service
            android:name="com.google.android.play.core.assetpacks.ExtractionForegroundService"
            tools:remove="android:foregroundServiceType" />

        <!--
            Инструменты нейросети на телефоне (AppFunctions, Android 16+). Экспортирована,
            потому что её вызывает система от имени агента, но каждая функция открыта
            только своему приложению (ACCESS_LEVEL_SELF), а привязаться к службе может
            лишь держатель системного разрешения BIND_APP_FUNCTION_SERVICE.
            Ниже Android 16 служба выключена: её класс наследует платформенный, которого там нет.
        -->
        <service
            android:name=".assistant.KcalAppFunctionService"
            android:enabled="@bool/app_functions"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="kcal_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <!-- «Записать: гречка» в уведомлении персонажа. Только для своих PendingIntent. -->
        <receiver
            android:name=".notify.LogSuggestionReceiver"
            android:exported="false" />
    </application>

</manifest>
