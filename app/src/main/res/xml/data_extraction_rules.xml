<?xml version="1.0" encoding="utf-8"?>
<!--
    Дневник, цели и свои продукты переезжают вместе с человеком.
    Кадры съёмки этикеток — нет: это диагностика, а на снимках чужая кухня.
    Для Android 11 и ниже то же самое — в backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="label-scans/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="label-scans/" />
    </device-transfer>
</data-extraction-rules>
