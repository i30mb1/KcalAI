<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleDisplayName</key>
	<string>Kcal AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.3</string>
	<key>CFBundleVersion</key>
	<string>5</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
		Без этого на айфонах с ProMotion экран обновлялся бы 60 раз в секунду
		вместо 120: лента и перебежки персонажей шли бы вдвое грубее. Compose
		это проверяет и без ключа не запускается вовсе.
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Камера понадобится сканеру: без описания система не спросит разрешение, а откажет. -->
	<key>NSCameraUsageDescription</key>
	<string>Чтобы считать штрих-код и прочитать состав с этикетки</string>
	<!--
		Фоновая работа: отправка вкладов и докачка справочника. Идентификаторы
		обязаны быть здесь — незаявленную задачу система поставить не даёт.
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>n7.kcalai.contributions</string>
		<string>n7.kcalai.seed</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- Адрес сервера. Пусто — источника нет, всё остаётся на устройстве. -->
	<key>KcalServer</key>
	<string>$(KCAL_SERVER)</string>
</dict>
</plist>
